[Unit]
Description=nut_webgui - Simple NUT Web interface
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/nut_webgui/nut_webgui.env
ExecStart=/usr/local/bin/nut_webgui --allow-env --config-file /etc/nut_webgui/config.toml --server-key-file /etc/nut_webgui/server.key
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

